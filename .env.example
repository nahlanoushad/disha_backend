# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/disha?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/disha?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=1d

# Initial Admin Credentials (Seeded on first run)
ADMIN_EMAIL=admin@disha.edu
ADMIN_USERNAME=admin
# Required to create the first admin account. Use a strong, unique password.
ADMIN_PASSWORD=

# Email (sign-up verification codes), sent through Gmail
FROM_EMAIL=your-address@gmail.com
# A Gmail App Password (16 characters), not your normal Gmail password
EMAIL_PASSWORD=

# Push notifications (Firebase Cloud Messaging)
# Path to the service-account key: Firebase console > Project settings > Service accounts.
# Relative paths start from the backend folder. Never commit the key file.
GOOGLE_APPLICATION_CREDENTIALS=./src/config/firebase-secret.json
# Public https address of the frontend, used when a notification is clicked. Leave empty for local development.
FRONTEND_URL=
